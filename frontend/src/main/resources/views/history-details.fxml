<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.miage.skull.controllers.HistoryDetailsController" styleClass="page">
    <top>
        <fx:include source="nav.fxml"/>
    </top>
    <center>
        <VBox spacing="18" styleClass="content-area">
            <Label text="Détails de la partie" styleClass="heading dark"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="history-scroll">
                <content>
                    <VBox fx:id="rows" spacing="12"/>
                </content>
            </ScrollPane>
            <Button text="Retour à l’historique" onAction="#back" styleClass="gold"/>
        </VBox>
    </center>
</BorderPane>