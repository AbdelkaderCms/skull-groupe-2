<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.miage.skull.controllers.MenuController" styleClass="page">
    <top>
        <fx:include source="nav.fxml"/>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="65">
            <padding>
                <Insets top="35" bottom="35" left="55" right="55"/>
            </padding>
            <HBox alignment="CENTER" spacing="20" styleClass="panel">
                <VBox spacing="18" HBox.hgrow="ALWAYS">
                    <Label text="Skull" styleClass="logo"/>
                    <Label text="Posez vos disques. Observez vos adversaires. Lancez l’enchère au bon moment et ne retournez jamais un crâne."
                           wrapText="true" maxWidth="340"/>
                    <Button text="Voir les règles" onAction="#pending" styleClass="link"/>
                </VBox>
                <HBox fx:id="equippedTiles" alignment="CENTER"/>
            </HBox>
            <HBox alignment="CENTER" spacing="180">
                <Button text="Créer une partie&#10;+" onAction="#createGame" styleClass="round"/>
                <Button text="Rejoindre une partie&#10;↗" onAction="#pending" styleClass="round"/>
            </HBox>
            <Label fx:id="feedback" styleClass="dark"/>
        </VBox>
    </center>
</BorderPane>
